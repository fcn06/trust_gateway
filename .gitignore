# ═══════════════════════════════════════════════════════
#  Trust Gateway — Git Ignore Rules
# ═══════════════════════════════════════════════════════

# ── Build & Compilation Artifacts ────────────────────
/target/
**/target/
**/*.rs.bk
Cargo.lock

# ── Cryptographic Keys & Secrets (Secure-by-Default) ─
**/*.key
**/*.pem
**/*.nkey
**/*.pub
**/server.keys
.keys/
.nkeys/
secrets/
secrets.conf
secrets_*.conf

# ── Environment & Local Configuration Overrides ─────
.env
.env.local
.env.*.local
*.env
config/policy.local.toml
config/secrets.toml

# ── Runtime State, Logs & Storage ────────────────────
**/*.log
logs/
.nats_data/
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal
audit.jsonl
**/manifest.json

# ── IDE & OS Files ───────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
scratch/
tmp/


# ── Private / Internal Agent Documentation ──────────
docs/agent_identity/
docs/local_command_line/
docs/sample_calls_b2b_agent/