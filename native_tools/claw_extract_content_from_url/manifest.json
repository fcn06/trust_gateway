{
  "schema_version": "lianxi.skill/v1",
  "id": "io.lianxi.skill.extract_content_from_url@v1",
  "name": "claw_extract_content_from_url",
  "version": "1.0.0",
  "description": "Extracts text content, articles, and transcripts from a given URL.",
  "author_did": "did:web:lianxi.io",
  "data_origin_trust": "UntrustedExternal",
  "lineage_rules": [],
  "execution": {
    "runtime": "native_tool",
    "entrypoint": "run.sh",
    "timeout_secs": 30,
    "memory_limit_mb": 512,
    "allowed_interpreters": ["bash", "sh"]
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "The URL to extract content from."
      }
    },
    "required": ["url"]
  },
  "policy_defaults": {
    "default_tier": "tier0_auto",
    "max_frequency_per_trace": 3,
    "default_risk_level": "low",
    "operation_kind": "read"
  },
  "egress": {
    "contains_pii": false,
    "max_payload_bytes": 65536,
    "allowed_fields": ["result", "skill", "action_id"]
  }
}
